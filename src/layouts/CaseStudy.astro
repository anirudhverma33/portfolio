---
import Base from './Base.astro';
import { getProject, methodGlyph, methodLabel, neighbours } from '../lib/projects';
import { getPublication, theses, ME } from '../lib/publications';
import { url } from '../lib/site';

interface Props {
  slug: string;
  setting: string;
  /** Statements of the author's own contribution. Each must be confirmed by the author or a source. */
  contribution: { text: string; basis: string }[];
  /** Collaborator roles, only where a source states them. */
  collaborators: { text: string; basis: string }[];
}

const { slug, setting, contribution, collaborators } = Astro.props;
const p = getProject(slug);
const pub = p.publication ? getPublication(p.publication) : undefined;
const thesis = p.thesis ? theses.find((t) => t.id === p.thesis) : undefined;
const { prev, next } = neighbours(slug);

for (const name of ['problem', 'method', 'results', 'figures']) {
  if (!Astro.slots.has(name)) throw new Error(`Case study "${slug}" is missing its "${name}" section`);
}
if (!contribution.length || contribution.some((c) => !c.text || !c.basis)) {
  throw new Error(`Case study "${slug}" needs a confirmed contribution statement`);
}

const sections = [
  ['problem', 'Problem'],
  ['method', 'Method'],
  ['results', 'Reported results'],
  ...(Astro.slots.has('interactive') ? [['interactive', 'Explore']] : []),
  ['figures', 'Figures'],
  ['contribution', 'My contribution'],
  ['collaborators', 'Collaborators'],
  ['paper', pub ? 'Paper' : 'Thesis'],
];

const jsonLd = pub
  ? {
      '@context': 'https://schema.org',
      '@type': 'ScholarlyArticle',
      headline: pub.title,
      author: pub.authors.map((name) => ({ '@type': 'Person', name })),
      datePublished: String(pub.year),
      ...(pub.doi ? { sameAs: `https://doi.org/${pub.doi}` } : { url: `https://arxiv.org/abs/${pub.arxiv}` }),
    }
  : undefined;
---

<Base title={p.title} description={p.summary} jsonLd={jsonLd}>
  <div class="wrap case">
    <header class="head">
      <p class="meta sans"><span aria-hidden="true">{methodGlyph[p.method]}</span> {methodLabel[p.method]}</p>
      <h1>{p.title}</h1>
      <p class="lede">{p.summary}</p>
      <dl class="facts">
        <div><dt>Setting</dt><dd>{setting}</dd></div>
        <div><dt>Period</dt><dd>{p.period}</dd></div>
        {pub && (
          <div>
            <dt>Paper</dt>
            <dd>
              {pub.status === 'published' ? <><em>{pub.venue}</em> ({pub.year})</> : <>Under review, <em>{pub.venue}</em>; arXiv:{pub.arxiv} (status as of {pub.statusAsOf.replace(' (CV)', '')})</>}
            </dd>
          </div>
        )}
        {pub && (
          <div>
            <dt>Authors</dt>
            <dd>{pub.authors.map((a, i) => <>{a === ME ? <strong>{a}</strong> : a}{i < pub.authors.length - 1 ? ', ' : ''}</>)}</dd>
          </div>
        )}
        {thesis && <div><dt>Thesis</dt><dd>{thesis.title}. {thesis.detail}</dd></div>}
      </dl>
    </header>

    <div class="layout">
      <nav class="toc" aria-label="On this page">
        <details open>
          <summary>Contents</summary>
          <ol>
            {sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
          </ol>
        </details>
      </nav>

      <div class="body">
        <section id="problem"><h2>Problem</h2><slot name="problem" /></section>
        <section id="method"><h2>Method</h2><slot name="method" /></section>
        <section id="results"><h2>Reported results</h2><slot name="results" /></section>
        {Astro.slots.has('interactive') && (
          <section id="interactive"><h2>Explore</h2><slot name="interactive" /></section>
        )}
        <section id="figures"><h2>Figures</h2><slot name="figures" /></section>

        <section id="contribution">
          <h2>My contribution</h2>
          <ul class="statements">
            {contribution.map((c) => <li><p>{c.text}</p><p class="basis">{c.basis}</p></li>)}
          </ul>
        </section>

        <section id="collaborators">
          <h2>Collaborators</h2>
          <ul class="statements">
            {collaborators.map((c) => <li><p>{c.text}</p><p class="basis">{c.basis}</p></li>)}
          </ul>
        </section>

        <section id="paper">
          <h2>{pub ? 'Paper' : 'Thesis'}</h2>
          {pub && (
            <p class="links sans">
              {pub.arxiv && <a href={`https://arxiv.org/abs/${pub.arxiv}`}>arXiv:{pub.arxiv}</a>}
              {pub.arxiv && <a href={`https://arxiv.org/pdf/${pub.arxiv}`}>PDF</a>}
              {pub.doi && <a href={`https://doi.org/${pub.doi}`}>Journal article</a>}
              <a href={url('/papers/')}>Abstract and BibTeX</a>
            </p>
          )}
          {thesis && <p>{thesis.title}. {thesis.detail}</p>}
        </section>

        <nav class="pager sans" aria-label="More research">
          {prev ? <a href={url(`/research/${prev.slug}/`)}><span>Previous</span>{prev.title}</a> : <span />}
          {next ? <a class="next" href={url(`/research/${next.slug}/`)}><span>Next</span>{next.title}</a> : <a class="next" href={url('/research/')}><span>Back to</span>All research</a>}
        </nav>
      </div>
    </div>
  </div>
</Base>

<style>
  .head { padding-top: 32px; max-width: 900px; }
  .meta { font-size: var(--s-14); color: var(--graphite); margin-bottom: 12px; }
  h1 { font-size: 2.25rem; }
  @media (min-width: 640px) { h1 { font-size: var(--s-48); } }
  .lede { font-size: var(--s-21); line-height: 1.45; margin: 20px 0 32px; }
  .facts { display: grid; gap: 10px; margin: 0; font-size: var(--s-16); }
  .facts div { display: grid; grid-template-columns: 7rem 1fr; gap: 16px; }
  .facts dt { font-family: var(--sans); font-size: var(--s-14); color: var(--graphite); padding-top: 2px; }
  .facts dd { margin: 0; max-width: 64ch; }
  .facts strong { font-weight: 600; }
  @media (max-width: 520px) { .facts div { grid-template-columns: 1fr; gap: 0; } }

  .layout { display: grid; gap: 24px; margin-top: 48px; }
  .toc { font-family: var(--sans); font-size: var(--s-14); }
  .toc summary { cursor: pointer; padding: 10px 0; color: var(--graphite); }
  .toc ol { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--hairline); }
  .toc a { display: block; padding: 6px 0 6px 14px; color: var(--graphite); text-decoration: none; margin-left: -1px; border-left: 2px solid transparent; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current='true'] { color: var(--ink); border-left-color: var(--pump); }
  @media (min-width: 1100px) {
    .layout { grid-template-columns: 200px minmax(0, 1fr); gap: 56px; }
    .toc > details { position: sticky; top: 24px; }
    .toc summary { pointer-events: none; list-style: none; }
    .toc summary::-webkit-details-marker { display: none; }
  }

  .body { min-width: 0; }
  .body section { padding-top: 48px; }
  .body section:first-child { padding-top: 0; }
  .body h2 { font-size: var(--s-24); margin-bottom: 16px; }
  .body :global(h3) { font-size: var(--s-18); margin: 24px 0 8px; }
  .statements { list-style: none; padding: 0; margin: 0; }
  .statements li { padding: 12px 0; border-top: 1px solid var(--hairline); }
  .statements p { margin: 0; }
  .statements .basis { font-family: var(--sans); font-size: var(--s-14); color: var(--graphite); margin-top: 4px; }
  .links { display: flex; flex-wrap: wrap; gap: 0 24px; font-size: var(--s-16); }
  .links a { display: inline-block; padding: 10px 0; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--hairline); font-size: var(--s-16); }
  .pager a { color: var(--ink); text-decoration: none; padding: 8px 0; }
  .pager a:hover { color: var(--pump); }
  .pager span { display: block; font-size: var(--s-14); color: var(--graphite); }
  .pager .next { text-align: right; }
</style>

<script>
  // Mark the contents entry for the section currently in view.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [a.hash.slice(1), a]),
  );
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(e.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-20% 0px -70% 0px' },
  );
  document.querySelectorAll('.body section[id]').forEach((s) => io.observe(s));
  if (window.matchMedia('(max-width: 1099px)').matches) {
    document.querySelector('.toc details')?.removeAttribute('open');
  }
</script>

---
import '@fontsource/kanit/latin-300.css';
import '@fontsource/kanit/latin-300-italic.css';
import '@fontsource/kanit/latin-400.css';
import '@fontsource/kanit/latin-500.css';
import '@fontsource/kanit/latin-600.css';
import '@fontsource/kanit/latin-800.css';
import '@fontsource/kanit/latin-900.css';
import '../styles/global.css';
import { existsSync } from 'node:fs';
import { person, profiles, url } from '../lib/site';

interface Props {
  title?: string;
  description: string;
  jsonLd?: object;
  /** Homepage: the hero carries its own navigation, so the site header is omitted. */
  home?: boolean;
}

const { title, description, jsonLd, home = false } = Astro.props;
const fullTitle = title ? `${title} | ${person.name}` : person.name;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const hasCv = existsSync('public/cv.pdf');

const nav = [
  { href: '/research/', label: 'Research' },
  { href: '/papers/', label: 'Papers' },
  { href: '/about/', label: 'About' },
];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0c0c0c" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {!home && (
    <header class="site-header wrap">
      <a class="home" href={url('/')} aria-current={path === '/' ? 'page' : undefined}>{person.name}</a>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          {hasCv && (
            <li>
              <a href={url('/cv.pdf')}>CV</a>
            </li>
          )}
        </ul>
      </nav>
    </header>
    )}
    <main id="main" class:list={{ landing: home }}>
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="inner">
      <p>
        <a href={`mailto:${person.email}`}>{person.email}</a>
      </p>
      <ul>
        {profiles.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
      </ul>
      <p class="fine">
        Figures from published papers are reproduced with citation. Numbers on this site are quoted from the cited sources.
      </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 24px;
    padding-top: 20px;
    padding-bottom: 20px;
    font-family: var(--sans);
    font-size: var(--s-14);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .site-header a {
    color: var(--ink);
    text-decoration: none;
    display: inline-block;
    padding: 12px 0;
    border-bottom: 2px solid transparent;
  }
  .site-header .home { font-weight: 500; }
  .site-header a:hover { border-bottom-color: var(--hairline); }
  .site-header a[aria-current='page'] { border-bottom-color: #b600a8; }
  .site-header .home[aria-current='page'] { border-bottom-color: transparent; }
  nav ul { display: flex; gap: 20px; list-style: none; margin: 0; padding: 0; }
  @media (min-width: 640px) {
    .site-header { font-size: var(--s-16); }
    nav ul { gap: 32px; }
  }

  .site-footer {
    margin-top: var(--section);
    padding-bottom: 48px;
    font-family: var(--sans);
    font-size: var(--s-14);
    color: var(--graphite);
  }
  .site-footer .inner { border-top: 1px solid var(--hairline); padding-top: 32px; }
  .site-footer a { color: var(--ink); }
  .site-footer ul { display: flex; flex-wrap: wrap; gap: 4px 24px; list-style: none; padding: 0; margin: 0 0 16px; }
  .site-footer a { display: inline-block; padding: 8px 0; }
  .site-footer p { margin: 0 0 8px; }
  .site-footer .fine { max-width: 60ch; }
</style>

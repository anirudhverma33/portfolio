---
// Measured coincidence fringes from BS thesis Table 5.2, drawn at build time.
// Two layouts share the data: a wide one, and a narrow one with fewer ticks and larger type for phones.
import data from '../../data/bs-thesis-table-5-2.json';

interface Variant {
  key: 'wide' | 'narrow';
  W: number;
  H: number;
  m: { l: number; r: number; t: number; b: number };
  font: number;
  labelFont: number;
  dot: number;
  ticksX: number[];
  ticksY: number[];
}

const variants: Variant[] = [
  { key: 'wide', W: 1000, H: 400, m: { l: 64, r: 24, t: 24, b: 48 }, font: 15, labelFont: 18, dot: 3.6, ticksX: [0, 45, 90, 135, 180, 225, 270, 315, 360], ticksY: [0, 1000, 2000, 3000, 4000, 5000] },
  { key: 'narrow', W: 400, H: 330, m: { l: 44, r: 12, t: 22, b: 38 }, font: 13, labelFont: 15, dot: 2.6, ticksX: [0, 90, 180, 270, 360], ticksY: [0, 2000, 4000] },
];

const yMax = 5000;
const styles: Record<string, { dash?: string; opacity: number }> = {
  H: { opacity: 1 },
  D: { opacity: 0.55, dash: '10 6' },
  V: { opacity: 1, dash: '2 5' },
  A: { opacity: 0.55 },
};
const start = 6; // 90°
const basisName: Record<string, string> = { H: 'H (0°)', D: 'D (45°)', V: 'V (90°)', A: 'A (135°)' };

const geometry = (v: Variant) => {
  const x = (a: number) => v.m.l + (a / 360) * (v.W - v.m.l - v.m.r);
  const y = (c: number) => v.H - v.m.b - (c / yMax) * (v.H - v.m.t - v.m.b);
  // Catmull–Rom spline through the measured points (display only; no fit).
  const path = (counts: number[]) => {
    const pts = counts.map((c, i) => [x(data.angles[i]), y(c)]);
    let d = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[Math.max(i - 1, 0)], p1 = pts[i], p2 = pts[i + 1], p3 = pts[Math.min(i + 2, pts.length - 1)];
      const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
      const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
      d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
    }
    return d;
  };
  // Label each series at its first maximum.
  const labels = data.series.map((s) => {
    const i = s.counts.indexOf(Math.max(...s.counts.slice(0, 13)));
    return { basis: s.basis, x: x(data.angles[i]), y: y(s.counts[i]) - v.labelFont * 0.75 };
  });
  return { x, y, path, labels };
};
const drawn = variants.map((v) => ({ v, g: geometry(v) }));
---

<figure class="fringe" data-fringe>
  <div class="bench plot">
    {drawn.map(({ v, g }) => (
      <svg
        class={`v-${v.key}`}
        viewBox={`0 0 ${v.W} ${v.H}`}
        role="img"
        aria-label="Polarization correlation fringes: coincidence counts per 5 seconds for analyzer angles from 0 to 360 degrees in 15 degree steps, with the first polarizer at H, D, V and A. Each series oscillates between about 20 and 4,600 counts, shifted by 45 degrees from the next."
        data-w={v.W}
        data-l={v.m.l}
        data-r={v.m.r}
        style={`--font:${v.font}px; --label:${v.labelFont}px`}
      >
        <g class="axis">
          {v.ticksY.map((t) => (
            <g>
              <line x1={v.m.l} x2={v.W - v.m.r} y1={g.y(t)} y2={g.y(t)} class="grid" />
              <text x={v.m.l - 8} y={g.y(t) + v.font / 3} text-anchor="end">{t.toLocaleString('en-US')}</text>
            </g>
          ))}
          {v.ticksX.map((t) => <text x={g.x(t)} y={v.H - v.m.b + v.font + 10} text-anchor="middle">{t}°</text>)}
        </g>
        <clipPath id={`fringe-reveal-${v.key}`}><rect class="reveal" x="0" y="0" width={v.W} height={v.H} /></clipPath>
        <g clip-path={`url(#fringe-reveal-${v.key})`}>
          {data.series.map((s) => (
            <g class="series" style={`opacity:${styles[s.basis].opacity}`}>
              <path d={g.path(s.counts)} stroke-dasharray={styles[s.basis].dash} class="line" />
              {s.counts.map((c, i) => <circle cx={g.x(data.angles[i])} cy={g.y(c)} r={v.dot} />)}
            </g>
          ))}
        </g>
        {g.labels.map((l) => <text class="label" x={l.x} y={l.y} text-anchor="middle">{l.basis}</text>)}
        <line class="cursor" x1={g.x(data.angles[start])} x2={g.x(data.angles[start])} y1={v.m.t} y2={v.H - v.m.b} data-cursor />
      </svg>
    ))}
  </div>
  <div class="controls" data-controls hidden>
    <label for="fringe-angle">Analyzer angle <output data-angle>{data.angles[start]}°</output></label>
    <input id="fringe-angle" type="range" min="0" max={data.angles.length - 1} step="1" value={start} />
  </div>
  <dl class="readout" aria-live="polite">
    {data.series.map((s) => (
      <div>
        <dt>{basisName[s.basis]}</dt>
        <dd data-basis={s.basis}>{s.counts[start].toLocaleString('en-US')}</dd>
      </div>
    ))}
  </dl>
  <figcaption>
    Measured coincidence counts per 5 s against analyzer angle, with the first polarizer set to H, D, V or A. Points are
    measurements; lines join them. Readout shows counts at the selected angle. Source: BS thesis, Table 5.2.
  </figcaption>
  <script type="application/json" data-fringe-data set:html={JSON.stringify({ angles: data.angles, series: data.series.map((s) => [s.basis, s.counts]) })} />
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-fringe]')) {
    const { angles, series } = JSON.parse(fig.querySelector('[data-fringe-data]')!.textContent!);
    const svgs = [...fig.querySelectorAll<SVGSVGElement>('svg')];
    const input = fig.querySelector<HTMLInputElement>('input')!;
    const out = fig.querySelector('[data-angle]')!;
    fig.querySelector<HTMLElement>('[data-controls]')!.hidden = false;
    const dims = (svg: SVGSVGElement) => ({ W: +svg.dataset.w!, l: +svg.dataset.l!, r: +svg.dataset.r! });
    const set = (i: number) => {
      for (const svg of svgs) {
        const { W, l, r } = dims(svg);
        const xx = String(l + (angles[i] / 360) * (W - l - r));
        const cursor = svg.querySelector('[data-cursor]')!;
        cursor.setAttribute('x1', xx);
        cursor.setAttribute('x2', xx);
      }
      out.textContent = `${angles[i]}°`;
      input.value = String(i);
      for (const [b, counts] of series) fig.querySelector(`[data-basis="${b}"]`)!.textContent = counts[i].toLocaleString('en-US');
    };
    input.addEventListener('input', () => set(+input.value));
    for (const svg of svgs) {
      const fromPointer = (e: PointerEvent) => {
        const { W, l, r } = dims(svg);
        const rect = svg.getBoundingClientRect();
        const vx = ((e.clientX - rect.left) / rect.width) * W;
        const a = ((vx - l) / (W - l - r)) * 360;
        set(Math.max(0, Math.min(angles.length - 1, Math.round(a / 15))));
      };
      svg.addEventListener('pointermove', fromPointer);
      svg.addEventListener('pointerdown', fromPointer);
    }
  }
</script>

<style>
  .fringe { margin: 0; }
  .plot { padding: 12px 8px 4px; touch-action: pan-y; }
  svg { width: 100%; height: auto; overflow: visible; }
  .v-narrow { display: none; }
  @media (max-width: 639px) {
    .v-wide { display: none; }
    .v-narrow { display: block; }
  }
  .axis text { font: 400 var(--font) var(--sans); fill: var(--graphite); }
  .grid { stroke: var(--hairline); stroke-width: 1; }
  .series .line { fill: none; stroke: var(--pump); stroke-width: 2; }
  .series circle { fill: var(--pump); }
  .reveal { transform-box: view-box; transform-origin: 0 0; animation: sweep 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .label { font: 500 var(--label) var(--sans); fill: var(--ink); }
  .cursor { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 3 4; }
  @keyframes sweep { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) {
    .reveal { animation: none; }
  }
  .controls { margin-top: 8px; font-family: var(--sans); font-size: var(--s-14); }
  .controls label { display: flex; justify-content: space-between; color: var(--graphite); }
  output { color: var(--ink); font-variant-numeric: tabular-nums; }
  .readout { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 8px 0 12px; font-family: var(--sans); }
  .readout dt { font-size: var(--s-14); color: var(--graphite); }
  .readout dd { margin: 0; font-size: var(--s-18); font-variant-numeric: tabular-nums; }
  figcaption { max-width: 72ch; }
</style>

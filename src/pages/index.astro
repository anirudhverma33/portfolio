---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import HeroSection from '../components/home/HeroSection';
import MarqueeSection from '../components/home/MarqueeSection';
import AboutSection from '../components/home/AboutSection';
import ExperienceSection from '../components/home/ExperienceSection';
import ProjectsSection from '../components/home/ProjectsSection';
import type { Img, ProjectData } from '../components/home/types';
import portrait from '../assets/portrait.jpg';
import { person, profiles, url } from '../lib/site';
import { projects, methodLabel } from '../lib/projects';
import { publications, statusText } from '../lib/publications';
import { experience } from '../lib/cv';
import { figuresByProject } from '../lib/gallery';

async function img(src: ImageMetadata, alt: string, widths: number[]): Promise<Img> {
  const w = widths.filter((x) => x <= src.width);
  const out = await getImage({ src, widths: w.length ? w : [src.width], format: 'webp' });
  return { src: out.src, srcSet: out.srcSet.attribute, width: src.width, height: src.height, alt };
}

const portraitCrop = await getImage({ src: portrait, width: 800, height: 1000, fit: 'cover', format: 'webp' });
const portraitImg: Img = {
  src: portraitCrop.src,
  srcSet: (await getImage({ src: portrait, widths: [440, 800], height: 1000, width: 800, fit: 'cover', format: 'webp' })).srcSet.attribute,
  width: 800,
  height: 1000,
  alt: 'Anirudh Verma on a bridge above a forested river valley.',
};

const marquee = (
  await Promise.all(
    projects.flatMap((p) =>
      figuresByProject[p.slug].map(async (f) => ({ ...(await img(f.src, f.alt, [420, 840])), href: url(`/research/${p.slug}/`) })),
    ),
  )
);
// Interleave projects so neighbouring tiles come from different work.
const order = marquee.map((_, i) => i).sort((a, b) => (a % 4) - (b % 4) || a - b);
const marqueeImages = order.map((i) => marquee[i]);

const projectData: ProjectData[] = await Promise.all(
  projects.map(async (p) => {
    const pub = p.publication ? publications.find((x) => x.id === p.publication) : undefined;
    const status = pub ? statusText(pub) : p.period;
    return {
      slug: p.slug,
      href: url(`/research/${p.slug}/`),
      category: `${methodLabel[p.method]} · ${status}`,
      title: p.title,
      summary: p.summary,
      status,
      images: await Promise.all(figuresByProject[p.slug].slice(0, 3).map((f) => img(f.src, f.alt, [480, 800, 1200]))),
    };
  }),
);

const contact = `mailto:${person.email}`;
const links = { about: '#about', research: '#research', papers: url('/papers/'), contact };
const aboutText =
  'I am a physicist working on quantum information with photons. My experimental work uses entangled photon pairs and a four-qubit photonic platform to generate publicly verifiable random numbers and to simulate Popescu–Rohrlich correlations. My theoretical work develops quantum-walk descriptions of scattering amplitudes, and my MS thesis studied free fermions under continuous measurement.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  email: `mailto:${person.email}`,
  affiliation: { '@type': 'Organization', name: 'Indian Institute of Science, Bengaluru' },
  sameAs: profiles.map((p) => p.href),
  knowsAbout: person.areas,
};
---

<Base
  home
  description="Anirudh Verma: photonic quantum information, quantum foundations, quantum walks and open quantum many-body systems. Research, papers and contact."
  jsonLd={jsonLd}
>
  <HeroSection
    client:load
    firstName="Anirudh"
    tagline="a physicist working on quantum information with photons"
    portrait={portraitImg}
    links={links}
  />
  <MarqueeSection client:visible images={marqueeImages} />
  <AboutSection client:visible text={aboutText} role={person.role} contact={contact} profiles={profiles} />
  <ExperienceSection client:visible items={experience} />
  <ProjectsSection client:visible projects={projectData} />

  <section aria-labelledby="papers-h" class="bg-[#0C0C0C] px-5 pb-10 pt-10 sm:px-8 md:px-10">
    <h2
      id="papers-h"
      class="hero-heading mb-12 text-center font-black uppercase leading-none tracking-tight sm:mb-16"
      style="font-size: clamp(3rem, 12vw, 160px)"
    >
      Papers
    </h2>
    <ol class="mx-auto max-w-5xl list-none">
      {
        publications.map((p, i) => {
          const href = p.doi ? `https://doi.org/${p.doi}` : `https://arxiv.org/abs/${p.arxiv}`;
          return (
            <li class="flex flex-col gap-2 py-7 sm:flex-row sm:gap-10" style={i ? 'border-top: 1px solid rgba(215, 226, 234, 0.15)' : undefined}>
              <p class="shrink-0 text-sm font-medium uppercase tracking-widest text-[#8E9AA3] sm:w-24 sm:pt-1">{p.year}</p>
              <div class="flex flex-col gap-2">
                <h3 class="font-medium leading-snug text-[#D7E2EA]" style="font-size: clamp(1rem, 1.8vw, 1.5rem)">
                  <a href={href} class="text-[#D7E2EA] no-underline transition-opacity duration-200 hover:opacity-70">{p.title}</a>
                </h3>
                <p class="text-sm font-light text-[#D7E2EA]/70 sm:text-base">{p.authors.join(', ')}</p>
                <p class="text-xs font-light uppercase tracking-widest text-[#8E9AA3] sm:text-sm">{statusText(p)}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
    <p class="mx-auto mt-10 max-w-5xl text-center">
      <a
        href={url('/papers/')}
        class="inline-flex items-center gap-2 rounded-full border-2 border-solid border-[#D7E2EA] px-8 py-3 text-sm font-medium uppercase tracking-widest text-[#D7E2EA] no-underline transition-colors duration-200 hover:bg-[#D7E2EA]/10 sm:px-10 sm:py-3.5 sm:text-base"
      >
        Abstracts, theses and BibTeX
      </a>
    </p>
  </section>
</Base>
